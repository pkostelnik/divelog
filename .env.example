# Non-secret placeholders. Copy to .env.local and fill with real values.

# App Configuration
NEXT_PUBLIC_APP_NAME=DiveLog Studio
# Produktion: https://divelog.copilot.ovh
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme

# ── Datenbank-Provider ──
# Unterstützte Werte: mock | cosmos | postgres | mysql
# mock     = In-Memory Demo-Daten (Standard, keine DB nötig)
# cosmos   = Azure Cosmos DB (benötigt AZURE_COSMOS_DB_* Variablen)
# postgres = PostgreSQL (benötigt DATABASE_URL)
# mysql    = MySQL (benötigt DATABASE_URL)
DB_PROVIDER=mock

# PostgreSQL / MySQL Connection String (nur wenn DB_PROVIDER=postgres oder mysql)
# DATABASE_URL=postgres://user:pass@localhost:5432/divelog
# DATABASE_URL=mysql://user:pass@localhost:3306/divelog

# Azure Cosmos DB (nur wenn DB_PROVIDER=cosmos)
AZURE_COSMOS_DB_ENDPOINT=https://localhost:8081
AZURE_COSMOS_DB_KEY=changeme
AZURE_COSMOS_DB_DATABASE=divelog

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=changeme
AZURE_STORAGE_ACCOUNT_KEY=changeme
AZURE_STORAGE_MEDIA_CONTAINER=media

# Application Insights
APPLICATION_INSIGHTS_CONNECTION_STRING=changeme

# SEO & Search Engine Verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-code

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Teams Integration (optional)
TEAMS_APP_ID=your-teams-app-id
